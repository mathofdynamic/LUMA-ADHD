{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luma-adhd",
  "account_id": "e691d5bc257b6135be4353568c1f7410",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },

  // These are non-secret identifiers and phase defaults. Runtime secrets are
  // intentionally absent; use .dev.vars locally and Wrangler secrets later.
  "vars": {
    "LUMA_ENVIRONMENT": "production",
    "LUMA_PHASE": "post-v1-openai-luna-migration",
    "ADMIN_SESSION_TTL_SECONDS": "43200",
    "NORMAL_AGENT_PROVIDER": "openai",
    "NORMAL_AGENT_BASE_URL": "https://api.openai.com/v1",
    "NORMAL_AGENT_MODEL": "gpt-5.6-luna",
    "NORMAL_AGENT_REASONING_EFFORT": "medium",
    "NEBULA_BASE_URL": "https://nebula-free-llm.nebula-ai-company.workers.dev/v1",
    "NEBULA_MODEL": "auto",
    "GOD_PROVIDER": "openai",
    "GOD_BASE_URL": "https://api.openai.com/v1",
    "GOD_MODEL": "gpt-5.6-luna",
    "GOD_REASONING_EFFORT": "xhigh"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luma-adhd",
      "database_id": "0098077a-4f95-4a05-8225-72edfa2f1e05",
      "migrations_dir": "./migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "AGENT_JOBS",
        "queue": "luma-adhd-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "luma-adhd-agent-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },

  // One light metronome is reserved for later bounded scheduling work.
  "triggers": {
    "crons": ["* * * * *"]
  },

  // The React/Vite build is served as Worker Static Assets. API routes run
  // first; navigation requests fall back to the SPA index.html asset.
  "assets": {
    "directory": "./admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*"]
  }

  // Telegram group/admin/identity values are live operational configuration.
  // They are intentionally omitted so `wrangler deploy --keep-vars` cannot
  // overwrite them with public placeholders. Use .dev.vars locally and the
  // operator bootstrap/deployment tooling for live values.
  // Runtime secret names (never add them to vars):
  // TELEGRAM_WEBHOOK_SECRET, TELEGRAM_*_BOT_TOKEN, NEBULA_API_KEY,
  // OPENAI_API_KEY, GOD_API_KEY, ADMIN_AUTH_SECRET.
  // Optional Browser Rendering is intentionally not bound in Phase 00.
}
