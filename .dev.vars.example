# LUMA ADHD local configuration contract.
# This file contains names only. Keep all values empty until a later phase.
# Copy to .dev.vars for local work; .dev.vars is git-ignored.

# Safe or operational identifiers (not authentication secrets).
LUMA_ENVIRONMENT=local
LUMA_PHASE=06-admin-observatory
CLOUDFLARE_ACCOUNT_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_BOT_IDENTITIES_JSON={}

# Telegram secrets. Required only when Phase 02 enables Telegram integration.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_GATEWAY_BOT_TOKEN=
TELEGRAM_PRODUCT_BOT_TOKEN=
TELEGRAM_GROWTH_BOT_TOKEN=
TELEGRAM_CREATIVE_BOT_TOKEN=
TELEGRAM_TECH_BOT_TOKEN=
TELEGRAM_FINANCE_BOT_TOKEN=
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_OPERATIONS_BOT_TOKEN=
TELEGRAM_HERETIC_BOT_TOKEN=

# Provider configuration. URLs and model names are identifiers; API keys are secrets.
# Phase 03's verified default is the Nebula /v1 gateway. Leave the key empty for
# local FakeProvider tests.
NEBULA_API_KEY=
NEBULA_BASE_URL=https://nebula-free-llm.nebula-ai-company.workers.dev/v1
NORMAL_AGENT_PROVIDER=openai
NORMAL_AGENT_BASE_URL=https://api.openai.com/v1
NORMAL_AGENT_MODEL=gpt-5.6-luna
NORMAL_AGENT_REASONING_EFFORT=medium
NEBULA_MODEL=auto
OPENAI_API_KEY=

GOD_API_KEY=
GOD_PROVIDER=openai
GOD_BASE_URL=https://api.openai.com/v1
GOD_MODEL=gpt-5.6-luna
GOD_REASONING_EFFORT=xhigh

# Admin authentication. Use a high-entropy local-only value for local admin tests.
ADMIN_AUTH_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200
